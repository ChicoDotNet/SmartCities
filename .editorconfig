root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets,slnx}]
indent_style = space
indent_size = 2

[*.{ts,tsx,json,md,yml,yaml,css,html,mjs}]
indent_style = space
indent_size = 2

[*.cs]
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:warning

[tests/**/*.cs]
# Descriptive xUnit method names intentionally use underscores for readability.
dotnet_diagnostic.CA1707.severity = none
