<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>SmartCities.Api</AssemblyName>
    <RootNamespace>SmartCities.Api</RootNamespace>
    <Description>ASP.NET Core API host for SmartCities.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SmartCities.Application/SmartCities.Application.csproj" />
    <ProjectReference Include="../SmartCities.Composition/SmartCities.Composition.csproj" />
    <ProjectReference Include="../SmartCities.Core/SmartCities.Core.csproj" />
    <ProjectReference Include="../SmartCities.Identity/SmartCities.Identity.csproj" />
  </ItemGroup>
</Project>
