<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SmartCities.Infrastructure.SqlServer</AssemblyName>
    <RootNamespace>SmartCities.Infrastructure.SqlServer</RootNamespace>
    <Description>SQL Server provider configuration and migrations for SmartCities.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <!-- Explicit transitive override for Microsoft.Data.SqlClient's vulnerable PKCS dependency.
         Fixes GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx; 9.0.21 is patched. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SmartCities.Infrastructure/SmartCities.Infrastructure.csproj" />
  </ItemGroup>
</Project>
