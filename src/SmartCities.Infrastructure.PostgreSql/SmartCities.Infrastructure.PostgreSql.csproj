<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SmartCities.Infrastructure.PostgreSql</AssemblyName>
    <RootNamespace>SmartCities.Infrastructure.PostgreSql</RootNamespace>
    <Description>PostgreSQL provider configuration and migrations for SmartCities.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SmartCities.Infrastructure/SmartCities.Infrastructure.csproj" />
  </ItemGroup>
</Project>
